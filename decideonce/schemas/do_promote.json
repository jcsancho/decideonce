{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decideonce:do_promote",
  "title": "do_promote input (point phases, plan phases, downgrade)",
  "type": "object",
  "properties": {
    "point_id": {"type": "string"},
    "phase": {"type": "string", "enum": ["collect", "shadow", "serve", "paused"]},
    "plan_phase": {"type": "string", "enum": ["collect", "shadow", "serve", "paused"]},
    "workflow": {"type": "string"},
    "downgrade": {"type": "boolean"},
    "confirm": {"type": "boolean"},
    "tier": {"type": "string", "enum": ["hosted_jev", "private"]}
  },
  "additionalProperties": false
}
