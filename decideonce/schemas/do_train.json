{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decideonce:do_train",
  "title": "do_train input",
  "type": "object",
  "required": [
    "point_id"
  ],
  "properties": {
    "point_id": {
      "type": "string"
    },
    "dry_run": {
      "type": "boolean"
    },
    "force": {
      "type": "boolean"
    },
    "confirm": {
      "type": "boolean"
    },
    "training_free_confirmed": {
      "type": "boolean"
    },
    "idem": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{8,64}$"
    },
    "cancel": {
      "type": [
        "string",
        "boolean"
      ]
    },
    "retry_eval": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
