{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decideonce:do_analyze",
  "title": "do_analyze input (includes gateway options)",
  "type": "object",
  "properties": {
    "workflow": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["skill", "prompt", "code"]},
        "text": {"type": "string"},
        "path": {"type": "string"}
      },
      "additionalProperties": false
    },
    "traces": {
      "type": "object",
      "required": ["path"],
      "properties": {"path": {"type": "string"}},
      "additionalProperties": false
    },
    "code": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "text"],
        "properties": {
          "path": {"type": "string"},
          "text": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "candidates": {"type": "array", "items": {"type": "object"}},
    "gateway": {"type": "boolean"},
    "discovery_key": {"type": "string"},
    "show_samples": {"type": "boolean"},
    "confirm": {"type": "boolean"}
  },
  "additionalProperties": false
}
