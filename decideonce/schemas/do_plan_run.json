{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decide-mcp/dm_plan_run.json",
  "title": "dm_plan_run input (spec §15.5)",
  "type": "object",
  "required": ["workflow", "input", "context"],
  "properties": {
    "workflow": {"type": "string"},
    "input": {"type": "string"},
    "context": {"type": "object"},
    "context_source": {"type": "string", "enum": ["agent", "regex", "form"]},
    "run_model": {"type": "string"},
    "cheap_model": {"type": "string"},
    "trial": {"type": "boolean"},
    "pilot_force": {"type": "boolean"},
    "pilot_mode": {"type": "string", "enum": ["inject", "downgrade"]},
    "task_ref": {"type": "string"}
  },
  "additionalProperties": false
}
