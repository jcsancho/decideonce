{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decideonce:do_decide",
  "title": "do_decide input",
  "type": "object",
  "required": ["point_id", "context"],
  "properties": {
    "point_id": {"type": "string"},
    "context": {"type": "object"},
    "teacher_cost": {
      "type": "object",
      "properties": {
        "tokens_in": {"type": "number"},
        "tokens_out": {"type": "number"},
        "usd": {"type": "number"},
        "seconds": {"type": "number"}
      },
      "additionalProperties": true
    },
    "run_id": {"type": "string"},
    "decision_pos": {
      "type": ["object", "null"],
      "required": ["event", "offset"],
      "properties": {
        "event": {"type": "integer"},
        "offset": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "at_start": {"type": "boolean"}
  },
  "additionalProperties": false
}
